{
  "name": "starbs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "db:build": "tsx scripts/build-drinks.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/run-sql.ts db/schema.sql",
    "db:seed": "tsx --env-file=.env.local scripts/run-sql.ts db/seed.sql db/drinks.generated.sql",
    "db:reset": "tsx --env-file=.env.local scripts/run-sql.ts db/reset.sql db/schema.sql db/seed.sql db/drinks.generated.sql",
    "db:status": "tsx --env-file=.env.local scripts/db-status.ts"
  },
  "dependencies": {
    "postgres": "^3.4.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  }
}
