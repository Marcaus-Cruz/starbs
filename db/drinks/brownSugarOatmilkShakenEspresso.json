{
  "name": "Brown Sugar Oatmilk Shaken Espresso",
  "category": "espresso",
  "iced": {
    "usesMilk": true,
    "usesIce": true,
    "recipes": {
      "tall":   { "espresso": 2, "classic syrup": 3, "cinnamon powder": 3 },
      "grande": { "espresso": 3, "classic syrup": 4, "cinnamon powder": 4 },
      "venti":  { "espresso": 4, "classic syrup": 5, "cinnamon powder": 5 }
    },
    "steps": [
      { "n": 1.0, "text": "Pull {shots} shots of espresso" },
      { "n": 2.0, "text": "Add {classic_syrup} pumps of classic syrup to the shaker" },
      { "n": 3.0, "text": "Add {cinnamon_powder} shakes of cinnamon powder to the shaker" },
      { "n": 4.0, "text": "Fill the cup with ice up to the line" },
      { "n": 5.0, "text": "Pour shots into shaker" },
      { "n": 6.0, "text": "Shake the shaker 10 times" },
      { "n": 7.0, "text": "Pour into cup" },
      { "n": 8.0, "text": "Top off cup with {milk}" },
      { "n": 9.0, "text": "Cap and serve" }
    ]
  }
}
