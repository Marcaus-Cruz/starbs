{
  "name": "Flat White",
  "category": "espresso",
  "defaultMilk": "Whole",
  "defaultIced": false,
  "hot": {
    "usesMilk": true,
    "recipes": {
      "short":  { "ristretto": 2 },
      "tall":   { "ristretto": 2 },
      "grande": { "ristretto": 3 },
      "venti":  { "ristretto": 3 }
    },
    "steps": [
      { "n": 1.0, "text": "Pull {ristretto} ristretto shots of espresso" },
      { "n": 1.5, "text": "Add {pumps} pumps of {flavor} to the cup", "when": "has_modifier" },
      { "n": 2.0, "text": "Pour shots over the {flavor}", "when": "has_modifier" },
      { "n": 2.0, "text": "Pour shots into the cup", "when": "no_modifier" },
      { "n": 3.0, "text": "Pour {milk} to the {size} line of the steaming pitcher" },
      { "n": 4.0, "text": "Steam the {milk}" },
      { "n": 5.0, "text": "Pour steamed {milk} slowly into the cup at pencil width" },
      { "n": 6.0, "text": "As the cup fills, bring the pitcher closer to the surface to create a dot on top" },
      { "n": 7.0, "text": "Purge and wipe the steam wand" },
      { "n": 8.0, "text": "Cap, sleeve, and serve" }
    ]
  }
}
